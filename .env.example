# Server
PORT=8000
NODE_ENV=development

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/projectmanagement

# JWT
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
REFRESH_TOKEN_EXPIRY=10d

# Where the password-reset email should point the user
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password

# SMTP (Mailtrap works well for development)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
