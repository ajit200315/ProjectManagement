# Server
PORT=8000
NODE_ENV=development

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/projectmanagement

# JWT
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
REFRESH_TOKEN_EXPIRY=10d

# Where the client is reachable. Email links (verification, password reset)
# are built from this, so it must be the address a recipient can open.
# In a single-origin deploy this is the same host as the API.
CLIENT_URL=http://localhost:5173

# Optional override for just the reset link; defaults to CLIENT_URL/reset-password
# FORGOT_PASSWORD_REDIRECT_URL=

# SMTP. Any provider works — the MAILTRAP_ prefix is historical.
#
# Mailtrap Sending (live mail):
#   host live.smtp.mailtrap.io, port 587, user "api", pass = your API token
# Mailtrap Email Testing (captured, never delivered):
#   host sandbox.smtp.mailtrap.io, port 2525, user/pass from the inbox
MAILTRAP_SMTP_HOST=
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=

# The sender address must be on a domain verified with your provider, or
# the send is rejected. Mailtrap's shared demo domain only delivers to the
# account owner's own address — verify a real domain before real users
# need to receive anything.
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Project Management
