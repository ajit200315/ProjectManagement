# Leave unset for the normal setup, where the client is served from the same
# origin as the API (production) or proxied to it (development, see
# vite.config.js). All requests are then relative and nothing is baked in.
#
# Set this ONLY if you deploy the client to a different domain than the API.
# It is embedded at build time, so it must be set before `npm run build`.
# VITE_API_URL=https://api.example.com
